# Copy to .env and fill in. .env is gitignored; this file is not, so never
# put a real secret here.
#
#   cp .env.example .env
#
# docker-compose.yml loads .env into BOTH the backend and the frontend, so
# API_KEY only needs setting once — but if you run the two services
# separately (or on Cloud Run) they each need the same value, or every
# frontend call comes back 403.

# ---------------------------------------------------------------- required

# Groq API key for the RAG chatbot and the LLM business summary.
# Without it those endpoints fail; everything else still works.
GROQ_API_KEY=

# Shared secret required in the `x-api-key` header on the research routes:
# /api/sentiment, /api/search, /api/rag, /api/analytics, /api/evaluation.
# Customer data (/api/v1/*, /api/imports, /api/jobs) does NOT accept it - those
# routes need a signed-in user's session cookie (Milestone 7).
# Leave unset locally to fall back to the development default in
# src/feedbackiq/core/config.py.
#
# REQUIRED when ENVIRONMENT=production — the backend refuses to start if it
# is unset or still the development default. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# ---------------------------------------------------------------- optional

# "development" (default) or "production". Production turns the API_KEY
# check above from a warning into a hard startup failure.
ENVIRONMENT=development

# Where the frontend looks for the backend. docker-compose sets this to
# http://backend:8000 automatically; set it explicitly when the two run
# apart, e.g. https://feedbackiq-backend-xxxxx.a.run.app
# API_URL=http://localhost:8000

# Comma-separated CORS origins. "*" (default) is fine locally. In a deployed
# environment set it to the frontend's real URL so arbitrary sites can't
# call the API from a user's browser.
#
# Since Milestone 7 this also decides two authentication details:
#   - a browser frontend on another origin can send the session cookie only
#     when this is an explicit list (credentials are never allowed with "*")
#   - sign-in, sign-out, uploads and other POSTs from an origin not listed
#     here (and not the API's own) are refused with 403
# ALLOWED_ORIGINS=https://feedbackiq-frontend-xxxxx.a.run.app

# The backend loads its FAISS index on the first request that needs it, not
# at startup, so the first call after a cold start can take ~a minute.
# Raise this if you see timeouts on a freshly started container.
# API_GET_TIMEOUT=90
# API_HEALTH_TIMEOUT=10

# ---------------------------------------------------------------- authentication (Milestone 7)
#
# Customer routes use server-side sessions. There is NO authentication secret
# to configure: the cookie holds a random token, and the database stores only
# its SHA-256 hash. Nothing is signed, so there is no key to leak or rotate.
# All three settings below are optional.

# How long a sign-in lasts, in hours. Absolute, not sliding.
# SESSION_TTL_HOURS=24

# The session cookie's name. Change only if something else on the domain uses it.
# SESSION_COOKIE_NAME=feedbackiq_session

# Whether the cookie is marked Secure (sent over HTTPS only). Unset means
# Secure exactly when ENVIRONMENT=production. Set it to false ONLY to try a
# production-like container over plain local HTTP - never on a deployed
# environment, which must be served over HTTPS.
# SESSION_COOKIE_SECURE=

# WARNING for anything below DEBUG/INFO in production — the request logging
# middleware writes a line per request. Logs go to stdout.
LOG_LEVEL=WARNING

# Optional: also write a rotating log file. Empty (the default) means stdout only,
# which is what a container wants.
# LOG_FILE=logs/feedbackiq.log
